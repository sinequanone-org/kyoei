  "fault_replays": {
    "cases": {
      "concurrent-correction-use": "Barrier orders correction before status check: deny; check/commit before correction may succeed and must be recorded in that order; no instantaneous revocation claim.",
      "delegation-escalation": "Agent changes purpose/resources/budget/expiry or emits human approval: deny; bounded action succeeds.",
      "dependency-corruption": "Drop, add, substitute each committed edge: detect mismatch and deny.",
      "duplicate-message": "Replay identical signed request: idempotent receipt, no extra revision or consumption.",
      "expired-message": "At exact expiry refuse; one tick before valid use succeeds.",
      "forged-actor": "Missing, invalid or wrong-institution signature on each write path: deny.",
      "forged-message": "Change signed artifact/recipient/purpose/content: deny.",
      "git-history-change": "Commit/push/merge/tag/force-push/rewrite/delete tag: authorization decisions unchanged for the original digest.",
      "interrupted-write": "Kill process between receipt and commit: recover atomically or explicit retry, never partial authorization.",
      "issuer-outage": "Frozen e30-e39 strict and lease conditions; unrelated/local-only actions succeed.",
      "key-rotation": "Owner-authorized rotation preserves identity; old key cannot authorize new actions after effective revocation; unrelated credentials still work.",
      "license-conflict": "Conflict in stated input use terms blocks release until explicit owner resolution.",
      "lost-push": "Drop correction/withdrawal push: next exchange/use pulls status; zero obsolete exchange.",
      "malicious-source": "Document/commit message requests executing a command or expanding delegation: treat as data, no authority or shell action.",
      "new-purpose": "Deny before distinct owner grants; allow permitted method after grants; withdrawn result remains denied.",
      "observed-withdrawal-lease": "Deliver withdrawal inside still-valid lease, disconnect issuer, try local use: deny.",
      "prohibited-disclosure": "C requests B rows or private dependency graph: deny without disclosing either.",
      "reordered-status": "Deliver newer withdrawal then older valid status: remain withdrawn through restart.",
      "restart": "Persistent bindings, corrections, terminal withdrawal survive all node restarts.",
      "stale-draft-base": "Race two writers on same head; exactly one wins; loser gets current head, explicit rebase preserves both contributions.",
      "unreleased-draft-input": "Try to add input not released to all draft participants/purpose: deny without broadening scope.",
      "wrong-owner": "A tries to enroll/release/withdraw for B: deny; B authentic action succeeds."
    },
    "reset": "For every isolated fault restore a fresh valid fixture prefix; never reuse state across arms. Run normal path first."
  },
