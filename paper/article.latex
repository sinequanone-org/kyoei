\documentclass[11pt,a4paper]{article}
\usepackage{lmodern}
\usepackage{fontspec}
\setmainfont{texgyrepagella-regular.otf}[BoldFont=texgyrepagella-bold.otf,ItalicFont=texgyrepagella-italic.otf,BoldItalicFont=texgyrepagella-bolditalic.otf]
\setsansfont{texgyreheros-regular.otf}[BoldFont=texgyreheros-bold.otf,ItalicFont=texgyreheros-italic.otf]
\setmonofont[Scale=0.82]{lmmono10-regular.otf}
\IfFontExistsTF{Hiragino Mincho ProN}{%
  \newfontfamily\japanesefont{Hiragino Mincho ProN}[Scale=0.92]%
  \newcommand{\KyoeiName}{{\japanesefont 共栄}}%
}{%
  \newcommand{\KyoeiName}{kyōei}%
}
\usepackage[margin=2.25cm,headheight=14pt,headsep=0.5cm,footskip=1cm]{geometry}
\usepackage{amsmath,amssymb}
\usepackage{longtable,booktabs,array,calc,graphicx,float}
\floatplacement{figure}{H}
\usepackage{titlesec,fancyhdr,enumitem,xurl,xcolor,caption}
\definecolor{ink}{HTML}{183C42}
\usepackage[hidelinks,unicode]{hyperref}
\hypersetup{pdftitle={$title$},pdfauthor={$author$}}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\sffamily\fontsize{8}{10}\selectfont\color{ink}KYOEI / REPAIRABLE COLLABORATION}
$if(review-status)$
\fancyfoot[L]{\sffamily\fontsize{8}{10}\selectfont\color{ink}$review-status$}
$endif$
\fancyfoot[R]{\sffamily\fontsize{9}{11}\selectfont\thepage}
\renewcommand{\headrulewidth}{0pt}
\titleformat{\section}{\sffamily\Large\bfseries\color{ink}}{\thesection}{0.65em}{}
\titleformat{\subsection}{\sffamily\normalsize\bfseries\color{ink}}{\thesubsection}{0.65em}{}
\titlespacing*{\section}{0pt}{15pt}{7pt}
\titlespacing*{\subsection}{0pt}{10pt}{5pt}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt}
\setlength{\emergencystretch}{3em}
\setlength{\LTpre}{6pt}
\setlength{\LTpost}{5pt}
\setlength{\tabcolsep}{5pt}
\renewcommand{\arraystretch}{1.14}
\let\oldlongtable\longtable
\let\endoldlongtable\endlongtable
\renewenvironment{longtable}{\fontsize{9.5}{12}\selectfont\oldlongtable}{\endoldlongtable}
\setlist{leftmargin=1.3em,itemsep=3pt,parsep=0pt,topsep=3pt}
\providecommand{\tightlist}{\setlength{\itemsep}{3pt}\setlength{\parskip}{0pt}}
\newcommand{\passthrough}[1]{#1}
\newcommand{\pandocbounded}[1]{#1}
\newcounter{none}
\captionsetup{font=small,labelfont=bf,justification=raggedright,singlelinecheck=false}
\widowpenalty=10000
\clubpenalty=10000
\brokenpenalty=10000
\begin{document}
\fontsize{10.5}{13.5}\selectfont
\thispagestyle{empty}
